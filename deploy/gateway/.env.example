# Fill these on the 5090 during later deployment.
COSMOS_UID=1000
COSMOS_GID=1000
COSMOS_MODE=preview
COSMOS_PROFILE=./config/profile.reference.json
COSMOS_INSTRUCTION=
# Choose a new directory name for each run; existing output is never overwritten.
COSMOS_RUN_ID=preview-001

# 5090 SSH listener; forwards to PRO 6000 localhost:8008.
COSMOS_SERVER_URL=http://127.0.0.1:18008
