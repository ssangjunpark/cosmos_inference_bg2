# Copy to .env only when preparing an approved deployment on FFW.
# Use an image already installed on FFW; automatic pulling is disabled.
ROBOTIS_IMAGE=robotis/ai-worker:2.2.8
ROS_DOMAIN_ID=30
COSMOS_MODE=preview
FFW_PROFILE=./config/profile.reference.json
# SNUPI head target 0.78 exceeds installed upper limit 0.6951; resolve before startup.
FFW_INITIAL_POSITIONS=/home/robotis/ai_worker/ffw_bringup/config/ffw_bg2_rev4_follower/bg2_vr_startup_snupi.yaml
